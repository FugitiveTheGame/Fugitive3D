; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Fugitive 3D"
run/main_scene="res://entry/Entry.tscn"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7")
boot_splash/image="res://splash.png"
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="uid://ur088vj6maj"
driver/enable_input=true
driver/mix_rate=48000

[autoload]

ClientNetwork="*res://networking/ClientNetwork.gd"
ServerNetwork="*res://networking/ServerNetwork.gd"
GameData="*res://networking/GameData.gd"
vr="*res://common/VrCompat.gd"
UserData="*res://common/UserData.gd"
Maps="*res://common/game/maps/MapDirectory.gd"
GameAnalytics="*uid://c1x6sqdxua5c6"
Feedback="*res://feedback/Feedback.gd"
ServerAdvertiserData="*res://addons/LANServerBroadcast/server_advertiser/ServerAdvertiserData.gd"
XRToolsUserSettings="*uid://bqgb8i74tm0t"
XRToolsRumbleManager="*uid://by853dk86g1qw"

[debug]

gdscript/warnings/return_value_discarded=false
gdscript/warnings/unused_argument=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="2d"
window/stretch/aspect="expand"
window/stretch/mode.mobile="2d"
window/stretch/aspect.mobile="keep_height"
window/size/viewport_height.OSX=900
window/size/viewport_width.X11=1600
window/size/viewport_height.X11=900
window/size/fullscreen.server=false
window/size/viewport_width.Windows=1600
window/size/viewport_height.Windows=900
window/size/fullscreen.debug=false
window/size/viewport_width.OSX=720

[editor_plugins]

enabled=PackedStringArray("res://addons/Fugitive3D/plugin.cfg", "res://addons/Godot-GameAnalytics/plugin.cfg", "res://addons/LANServerBroadcast/plugin.cfg", "res://addons/gdUnit4/plugin.cfg", "res://addons/godot-xr-tools/plugin.cfg")

[gui]

theme/custom="res://fugitive_theme.tres"
theme/use_hidpi=true

