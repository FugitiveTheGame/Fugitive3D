default_platform(:android)

platform :android do
  desc "Publish the AAB to the Google Play production track"
  lane :deploy do
    upload_to_play_store(
      track: 'production',
      release_status: 'completed',
      aab: ENV.fetch('AAB_PATH'),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      validate_only: ENV['PLAY_VALIDATE_ONLY'] == 'true'
    )
  end

  desc "Upload the AAB to the internal testing track"
  lane :internal do
    upload_to_play_store(
      track: 'internal',
      aab: ENV.fetch('AAB_PATH'),
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: false,
      validate_only: ENV['PLAY_VALIDATE_ONLY'] == 'true'
    )
  end
end
